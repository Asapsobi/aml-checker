# API keys for amlcheck. Copy this file to .env (in this folder, or in ~/.amlcheck/)
# and fill in the values. .env is git-ignored: never commit real keys.

# Eagle Virtual: stablecoin issuer freezes. Free key at https://eaglevirtual.com/account
# A paid plan's keys (Business has 5) can be listed with commas, and take turns when one's
# day is used up: EAGLE_VIRTUAL_API_KEY=ev_live_one,ev_live_two
EAGLE_VIRTUAL_API_KEY=

# TronGrid: TRON chain data. Works without a key, but rate-limited. https://www.trongrid.io
TRONGRID_API_KEY=

# Envio HyperSync: BSC transfer history. Free token at https://envio.dev/app/api-tokens
HYPERSYNC_API_TOKEN=

# The token a program on this computer sends to `amlcheck api` (docs/api.md). Only that
# command needs it. Make one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AMLCHECK_API_TOKEN=
